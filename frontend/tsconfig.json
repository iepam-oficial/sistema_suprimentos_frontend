{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    ".next-build-gate/types/**/*.ts",
    "/tmp/next-build-gate-sidebar/types/**/*.ts",
    "/tmp/next-build-gate-sidebar-576749/types/**/*.ts",
    ".next-validate/types/**/*.ts",
    "/tmp/t12-next-build-check/types/**/*.ts",
    ".t12-build-check/types/**/*.ts",
    ".t12-build-check/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "cypress",
    "tests"
  ]
}
